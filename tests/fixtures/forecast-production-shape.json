        "headline": "Synthetic diesel market review",
        "segments": [
          {
            "segmentId": "s1-11403b02e267",
            "text": "Synthetic fixture: oil and diesel supply tightened by 4% during the reported week as refiners adjusted operations and buyers reviewed fuel inventories."
          },
          {
            "segmentId": "s2-89a291588901",
            "text": "Synthetic fixture: diesel buyers reported slower deliveries while tanker availability and refinery schedules remained important for the fuel market."
          },
          {
            "segmentId": "s3-c32bba9ed02c",
            "text": "Synthetic fixture: crude and diesel participants could see demand and supply risks without confirming a new disruption today."
          }
        ]
      },
